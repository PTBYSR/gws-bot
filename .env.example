# Discord Self-bot token (How to get: inspect discord -> network tab -> find authorization header)
DISCORD_TOKEN=your_discord_token_here

# (Optional) User ID to receive DMs when a member joins. If left blank, it only logs to console and logs/joins.log
LOG_TARGET_USER_ID=

# (Optional) Comma-separated list of server IDs to monitor. If left blank, monitors all servers the account is in.
TARGET_SERVERS=

# (Optional) Port for the dummy web server. Defaults to 8080.
PORT=8080

# (Optional) MongoDB connection string for persistent join logs + missed join recovery.
# Get a free cluster at https://www.mongodb.com/atlas — use the Python driver connection string.
MONGO_URI=

# ─── Auto-Friend Request Configuration ───────────────────────────────────
# Enable the auto friend requester
ENABLE_AUTO_FRIEND=true

# Target server ID where new joins will trigger friend requests
AUTO_FRIEND_SERVER_ID=

# Token of the sender account (the account NOT in the server)
AUTO_FRIEND_SENDER_TOKEN=

# Label for logging / alert DMs
AUTO_FRIEND_SENDER_LABEL=SenderAccount

# Delay in seconds before dispatching friend request (default 1.5)
AUTO_FRIEND_DELAY=1.5

# (Optional) CapSolver API key to solve hCaptcha Enterprise if Discord challenges request
CAPSOLVER_API_KEY=
